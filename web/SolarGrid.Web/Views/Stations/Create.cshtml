@*
 * File:        Create.cshtml
 * Author:      WMVSB Wahundeniya (IT22292872)
 * Description: Form for Backoffice to create a new Solar Station.
 * Created:     29/09/2026
 *@
@model SolarGrid.Web.Models.CreateStationViewModel
@{
    ViewData["Title"] = "Add New Station";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">@ViewData["Title"]</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Station Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Malabe Solar Hub 01" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label">Address</label>
                        <input asp-for="Address" class="form-control" required />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Latitude" class="form-label">Latitude</label>
                            <input asp-for="Latitude" type="number" step="any" class="form-control" required />
                            <span asp-validation-for="Latitude" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Longitude" class="form-label">Longitude</label>
                            <input asp-for="Longitude" type="number" step="any" class="form-control" required />
                            <span asp-validation-for="Longitude" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="CapacityKw" class="form-label">Capacity (kW/h)</label>
                            <input asp-for="CapacityKw" type="number" step="any" class="form-control" required />
                            <span asp-validation-for="CapacityKw" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BatterySlots" class="form-label">Total Battery Slots</label>
                            <input asp-for="BatterySlots" type="number" class="form-control" required />
                            <span asp-validation-for="BatterySlots" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">Create Station</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
