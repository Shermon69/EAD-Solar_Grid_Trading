@*
    File:        _Alerts.cshtml
    Author:      Shermon H (IT22177964)
    Description: Shows success and error messages. In any controller, set
                 TempData["Success"] = "..." or TempData["Error"] = "..." before
                 redirecting, and the message appears on the next page.
*@
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show @(ViewData["FullWidth"] is true ? "rounded-0 mb-0" : "")" role="alert">
        <i class="bi bi-check-circle-fill"></i> @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show @(ViewData["FullWidth"] is true ? "rounded-0 mb-0" : "")" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
