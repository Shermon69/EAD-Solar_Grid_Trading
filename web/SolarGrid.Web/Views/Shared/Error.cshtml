@*
    File:        Error.cshtml
    Author:      Shermon H (IT22177964)
    Description: General error page shown when something unexpected goes wrong.
*@
@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-octagon display-1 text-danger"></i>
    <h1 class="h3 mt-3">Something went wrong</h1>
    <p class="text-muted">An error occurred while processing your request. Please try again.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-solar" asp-controller="Home" asp-action="Index">Back to Home</a>
</div>
