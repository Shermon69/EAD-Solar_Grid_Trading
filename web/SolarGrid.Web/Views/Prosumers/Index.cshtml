@*
    File:        Index.cshtml
    Author:      Premaratne R.A.N.C (IT22050908)
    Description: Prosumer Management list (Backoffice). Search, filter,
                 edit, activate, and deactivate prosumers.
*@
@model List<SolarGrid.Web.Models.ProsumerVm>

@{
    ViewData["Title"] = "Prosumer Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Prosumer Management</h2>
    <a asp-action="Create" class="btn btn-success">+ New Prosumer</a>
</div>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-md-5">
        <input name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Search by name, NIC or email" />
    </div>

    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var s in new[] { "Pending", "Active", "Deactivated" })
            {
                <option value="@s" selected="@((string?)ViewBag.Status == s)">@s</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary w-100">Search</button>
    </div>

    <div class="col-md-2">
        <a asp-action="Pending" class="btn btn-outline-secondary w-100">Pending activations</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>NIC</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Nic</td>
                    <td>@p.FullName</td>
                    <td>@p.Email</td>
                    <td>@p.Phone</td>

                    <td>
                        <div class="d-flex flex-column align-items-start gap-1">
                            <span class="badge @(p.Status == "Active"
                                                    ? "bg-success"
                                                    : p.Status == "Pending"
                                                        ? "bg-warning text-dark"
                                                        : "bg-secondary")">
                                @p.Status
                            </span>

                            @if (p.DeactivationRequested)
                            {
                                <span class="badge bg-danger">Deactivation requested</span>
                            }
                        </div>
                    </td>

                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="Edit" asp-route-id="@p.Nic"
                               class="btn btn-sm btn-outline-primary">Edit</a>

                            @if (p.Status != "Active")
                            {
                                <form asp-action="Activate" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Nic" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        @(p.Status == "Pending" ? "Activate" : "Reactivate")
                                    </button>
                                </form>
                            }

                            @if (p.Status != "Deactivated")
                            {
                                <form asp-action="Deactivate" method="post" class="d-inline"
                                      onsubmit="return confirm('Deactivate this prosumer?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Nic" />
                                    <button type="submit" class="btn btn-sm btn-danger">Deactivate</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">No prosumers found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
