@*
    File:        Index.cshtml (Users)
    Author:      Shermon H (IT22177964)
    Description: Staff User Management list page with role filter, search and
                 activate/deactivate actions.
*@
@model List<StaffUserViewModel>
@{
    ViewData["Title"] = "Staff Users";
    var selectedRole = ViewBag.Role as string;
    var search = ViewBag.Search as string;
    var currentNic = User.FindFirstValue(ClaimTypes.NameIdentifier);

    string TabClass(string? role) => selectedRole == role ? "active" : "";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-0">Staff Users</h1>
        <p class="text-muted mb-0">Backoffice and Grid Operator accounts for the web and mobile apps.</p>
    </div>
    <a class="btn btn-solar" asp-action="Create"><i class="bi bi-person-plus"></i> Add Staff User</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between gap-3 mb-3">
            <ul class="nav nav-pills">
                <li class="nav-item">
                    <a class="nav-link @TabClass(null)" asp-action="Index" asp-route-search="@search">All</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @TabClass(Roles.Backoffice)" asp-action="Index" asp-route-role="@Roles.Backoffice" asp-route-search="@search">Backoffice</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @TabClass(Roles.GridOperator)" asp-action="Index" asp-route-role="@Roles.GridOperator" asp-route-search="@search">Grid Operators</a>
                </li>
            </ul>

            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="hidden" name="role" value="@selectedRole" />
                <input type="search" name="search" value="@search" class="form-control" placeholder="Search name, NIC or email" />
                <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
            </form>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-people display-5"></i>
                <p class="mt-2 mb-0">No staff users found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>NIC</th>
                            <th>Contact</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var isMe = user.Nic == currentNic;
                            <tr>
                                <td class="fw-semibold">
                                    @user.FullName
                                    @if (isMe)
                                    {
                                        <span class="badge bg-light text-dark border ms-1">You</span>
                                    }
                                </td>
                                <td><code>@user.Nic</code></td>
                                <td class="small">
                                    <div><i class="bi bi-envelope text-muted"></i> @user.Email</div>
                                    <div><i class="bi bi-telephone text-muted"></i> @user.Phone</div>
                                </td>
                                <td>
                                    <span class="badge @(user.Role == Roles.Backoffice ? "bg-solar-dark" : "bg-info text-dark")">@user.RoleDisplay</span>
                                </td>
                                <td>
                                    @if (user.Status == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@user.Status</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@user.Nic">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>

                                    @if (user.Status == "Active")
                                    {
                                        @if (!isMe)
                                        {
                                            <form asp-action="Deactivate" asp-route-id="@user.Nic" method="post" class="d-inline"
                                                  onsubmit="return confirm('Deactivate @user.FullName? They will not be able to log in.');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-person-x"></i> Deactivate
                                                </button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <form asp-action="Activate" asp-route-id="@user.Nic" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-person-check"></i> Activate
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="small text-muted mt-3 mb-0">Showing @Model.Count user(s)</p>
        }
    </div>
</div>
