@*
    File:        _UserForm.cshtml
    Author:      Shermon H (IT22177964)
    Description: Form fields shared by the Create and Edit staff user pages.
*@
@model StaffUserFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<input type="hidden" asp-for="IsEdit" />

<h2 class="h6 text-uppercase text-muted fw-semibold mb-3">Personal details</h2>
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <label asp-for="Nic" class="form-label"></label>
        @if (Model.IsEdit)
        {
            <input asp-for="Nic" class="form-control" readonly />
            <div class="form-text">NIC is the primary key and cannot be changed.</div>
        }
        else
        {
            <input asp-for="Nic" class="form-control" placeholder="e.g. 199512345678 or 951234567V" />
            <span asp-validation-for="Nic" class="text-danger small"></span>
        }
    </div>
    <div class="col-md-6">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" placeholder="name@solargrid.lk" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" placeholder="07XXXXXXXX" />
        <span asp-validation-for="Phone" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
    </div>
</div>

<h2 class="h6 text-uppercase text-muted fw-semibold mb-3">Access</h2>
<div class="row g-3 mb-2">
    <div class="col-md-4">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" class="form-select">
            <option value="@Roles.GridOperator">Grid Operator</option>
            <option value="@Roles.Backoffice">Backoffice</option>
        </select>
        <span asp-validation-for="Role" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Password" class="form-label">@(Model.IsEdit ? "New password (optional)" : "Password")</label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    @if (Model.IsEdit)
    {
        <div class="col-12 form-text mt-1">Leave the password fields empty to keep the current password.</div>
    }
</div>
