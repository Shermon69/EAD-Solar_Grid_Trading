@*
    File:        Edit.cshtml (Users)
    Author:      Shermon H (IT22177964)
    Description: Page for updating a staff user's details, role or password.
*@
@model StaffUserFormViewModel
@{
    ViewData["Title"] = "Edit Staff User";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Staff Users</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h1 class="h4 fw-bold mb-1">Edit Staff User</h1>
        <p class="text-muted mb-4">Update the details of <strong>@Model.FullName</strong>.</p>

        <form asp-action="Edit" asp-route-id="@Model.Nic" method="post" novalidate>
            <partial name="_UserForm" model="Model" />

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-solar"><i class="bi bi-check-lg"></i> Save Changes</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
