@*
    File:        AccessDenied.cshtml
    Author:      Shermon H (IT22177964)
    Description: Shown when a user opens a page that their role is not allowed to use
                 (e.g. a Grid Operator opening Staff User Management).
*@
@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center py-5">
    <i class="bi bi-shield-lock display-1 text-danger"></i>
    <h1 class="h3 mt-3">Access denied</h1>
    <p class="text-muted">Your role does not have permission to open this page.</p>
    <a class="btn btn-solar" asp-controller="Home" asp-action="Index">Back to Home</a>
</div>
