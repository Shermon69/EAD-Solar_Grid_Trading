@*
 * File:        Index.cshtml
 * Author:      WMVSB Wahundeniya (IT22292872)
 * Description: Slot Availability page for managing time blocks at a station.
 * Created:     29/09/2026
 *@
@model List<SolarGrid.Web.Models.SlotViewModel>
@{
    ViewData["Title"] = $"Slot Availability - {ViewBag.StationName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-controller="Stations" asp-action="Index" class="btn btn-outline-secondary">Back to Stations</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Add New Slot Block</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <input type="hidden" name="StationId" value="@ViewBag.StationId" />
                    
                    <div class="mb-3">
                        <label class="form-label">Start Time</label>
                        <input type="datetime-local" name="StartTime" class="form-control" required />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">End Time</label>
                        <input type="datetime-local" name="EndTime" class="form-control" required />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Total Battery Slots Offered</label>
                        <input type="number" name="TotalSlots" class="form-control" required min="1" />
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100">Add Slot</button>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th>Availability</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slot in Model)
                        {
                            <tr>
                                <td>@slot.StartTime.ToLocalTime().ToString("g")</td>
                                <td>@slot.EndTime.ToLocalTime().ToString("g")</td>
                                <td>@slot.AvailableSlots / @slot.TotalSlots</td>
                                <td>
                                    @if (slot.IsAvailable && slot.AvailableSlots > 0)
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                    else if (!slot.IsAvailable)
                                    {
                                        <span class="badge bg-warning">Disabled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Full</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this slot? It will fail if bookings exist.');">
                                        <input type="hidden" name="id" value="@slot.Id" />
                                        <input type="hidden" name="stationId" value="@slot.StationId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No slots added yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
