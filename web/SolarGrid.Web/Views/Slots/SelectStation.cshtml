@*
    File:        SelectStation.cshtml (Slots)
    Author:      Shermon H (IT22177964)
    Description: Shown when the Slot Availability page is opened without a station.
                 The user picks which station's battery slots to manage.
*@
@model List<StationViewModel>
@{
    ViewData["Title"] = "Slot Availability";
}

<div class="mb-4">
    <h1 class="h3 fw-bold mb-0">Slot Availability</h1>
    <p class="text-muted mb-0">Choose a solar station to add or update its battery slot blocks.</p>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-geo-alt display-5"></i>
        <p class="mt-2 mb-0">No stations found.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var station in Model.OrderByDescending(s => s.IsActive).ThenBy(s => s.Name))
        {
            <div class="col-sm-6 col-lg-4">
                <a class="card action-card h-100 @(station.IsActive ? "" : "opacity-50")"
                   asp-action="Index" asp-route-stationId="@station.Id">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="feature-icon bg-solar-soft"><i class="bi bi-lightning-charge"></i></div>
                            <span class="badge @(station.IsActive ? "bg-success" : "bg-secondary")">@(station.IsActive ? "Active" : "Deactivated")</span>
                        </div>
                        <h2 class="h6 fw-bold mt-3 mb-1">@station.Name</h2>
                        <p class="small text-muted mb-2">@station.Address</p>
                        <p class="small mb-0">
                            <i class="bi bi-battery-charging text-muted"></i> @station.BatterySlots battery slots
                            &middot; @station.CapacityKw kW/h
                        </p>
                    </div>
                </a>
            </div>
        }
    </div>
}
