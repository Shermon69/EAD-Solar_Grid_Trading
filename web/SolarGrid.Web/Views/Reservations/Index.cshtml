@model List<SolarGrid.Web.Models.BookingRecord>

@{
    ViewData["Title"] = "Energy Reservations";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Energy Reservations</h2>
            <p class="text-muted mb-0">
                Manage and monitor energy trading reservations.
            </p>
        </div>

        <div class="d-flex gap-2">

            <!-- Create Reservation -->
            <a asp-controller="Reservations"
               asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Create Reservation
            </a>

            <!-- Dashboard -->
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Dashboard
            </a>

        </div>
    </div>


    <!-- Filters -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-controller="Reservations"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <!-- Status -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status" class="form-select">
                            <option value="">All Statuses</option>

                            @if (ViewBag.Status == "Pending")
                            {
                                <option value="Pending" selected>Pending</option>
                            }
                            else
                            {
                                <option value="Pending">Pending</option>
                            }

                            @if (ViewBag.Status == "Approved")
                            {
                                <option value="Approved" selected>Approved</option>
                            }
                            else
                            {
                                <option value="Approved">Approved</option>
                            }

                            @if (ViewBag.Status == "Completed")
                            {
                                <option value="Completed" selected>Completed</option>
                            }
                            else
                            {
                                <option value="Completed">Completed</option>
                            }

                            @if (ViewBag.Status == "Cancelled")
                            {
                                <option value="Cancelled" selected>Cancelled</option>
                            }
                            else
                            {
                                <option value="Cancelled">Cancelled</option>
                            }

                        </select>
                    </div>


                    <!-- Prosumer NIC -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Prosumer NIC
                        </label>

                        <input type="text"
                               name="nic"
                               value="@ViewBag.Nic"
                               class="form-control"
                               placeholder="Enter Prosumer NIC" />
                    </div>


                    <!-- Station ID -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            Station ID
                        </label>

                        <input type="text"
                               name="stationId"
                               value="@ViewBag.StationId"
                               class="form-control"
                               placeholder="Enter Station ID" />
                    </div>


                    <!-- Buttons -->
                    <div class="col-md-2 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-fill">
                            <i class="bi bi-search"></i>
                            Filter
                        </button>

                        <a asp-controller="Reservations"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg"></i>
                        </a>

                    </div>

                </div>

            </form>

        </div>
    </div>


    <!-- Reservation Count -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h5 class="fw-semibold mb-0">
            Reservation Records
        </h5>

        <span class="badge bg-secondary">
            @(Model?.Count ?? 0) reservation(s)
        </span>

    </div>


    <!-- Reservations Table -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-calendar-x display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No reservations found
                    </h5>

                    <p class="text-muted mb-0">
                        There are no reservations matching the selected filters.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="px-4">Prosumer NIC</th>
                                <th>Station</th>
                                <th>Reservation Date</th>
                                <th>Status</th>
                                <th>QR Token</th>
                                <th class="text-end px-4">Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var booking in Model)
                            {
                                <tr>

                                    <!-- Prosumer -->
                                    <td class="px-4">
                                        <span class="fw-semibold">
                                            @booking.ProsumerNic
                                        </span>
                                    </td>


                                    <!-- Station -->
                                    <td>
                                        <div class="d-flex align-items-center">

                                            <i class="bi bi-sun-fill text-warning me-2"></i>

                                            <span>
                                                @booking.StationName
                                            </span>

                                        </div>
                                    </td>


                                    <!-- Date -->
                                    <td>
                                        @(booking.ReservationDate
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy, hh:mm tt"))
                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (booking.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (booking.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else if (booking.Status == "Completed")
                                        {
                                            <span class="badge bg-primary">
                                                Completed
                                            </span>
                                        }
                                        else if (booking.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @booking.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- QR -->
                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(booking.QrToken))
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                <i class="bi bi-qr-code me-1"></i>
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-end px-4">

                                        <div class="d-flex justify-content-end gap-2">

                                            <!-- Details -->
                                            <a asp-controller="Reservations"
                                               asp-action="Details"
                                               asp-route-id="@booking.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="View Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- Approve -->
                                            @if (booking.Status == "Pending")
                                            {
                                                <form asp-controller="Reservations"
                                                      asp-action="Approve"
                                                      asp-route-id="@booking.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Approve"
                                                            onclick="return confirm('Are you sure you want to approve this reservation?');">

                                                        <i class="bi bi-check-lg"></i>

                                                    </button>

                                                </form>
                                            }


                                            <!-- Cancel -->
                                            @if (booking.Status == "Pending" ||
                                                 booking.Status == "Approved")
                                            {
                                                <form asp-controller="Reservations"
                                                      asp-action="Cancel"
                                                      asp-route-id="@booking.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Cancel"
                                                            onclick="return confirm('Are you sure you want to cancel this reservation?');">

                                                        <i class="bi bi-x-lg"></i>

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>