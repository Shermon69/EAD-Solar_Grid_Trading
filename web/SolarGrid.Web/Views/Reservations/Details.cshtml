@*
 * File:        Details.cshtml
 * Author:      Dissanayake D.M.S.N (IT22210692)
 * Description: Displays the details, QR information and available
 *              actions for an energy reservation.
 * Created:     29/09/2026
 *@

@model SolarGrid.Web.Models.BookingRecord

@{
    ViewData["Title"] = "Reservation Details";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Reservation Details</h2>
            <p class="text-muted mb-0">
                View the details of this energy reservation.
            </p>
        </div>

        <a asp-controller="Reservations"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Reservations
        </a>
    </div>

    <!-- Reservation Details -->
    <div class="row g-4">

        <!-- Main Details -->
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-calendar-check me-2"></i>
                        Booking Information
                    </h5>
                </div>

                <div class="card-body">

                    <div class="row g-4">

                        <!-- Reservation ID -->
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">
                                RESERVATION ID
                            </label>

                            <div class="mt-1">
                                <span class="font-monospace">
                                    @Model.Id
                                </span>
                            </div>
                        </div>

                        <!-- Prosumer NIC -->
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">
                                PROSUMER NIC
                            </label>

                            <div class="mt-1 fw-semibold">
                                @Model.ProsumerNic
                            </div>
                        </div>

                        <!-- Station -->
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">
                                SOLAR STATION
                            </label>

                            <div class="mt-1">
                                <i class="bi bi-sun-fill text-warning me-2"></i>
                                @Model.StationName
                            </div>
                        </div>

                        <!-- Reservation Date -->
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">
                                RESERVATION DATE
                            </label>

                            <div class="mt-1">
                                <i class="bi bi-calendar3 me-2"></i>
                                @(Model.ReservationDate.ToLocalTime().ToString("dd MMMM yyyy"))
                            </div>

                            <div class="text-muted small mt-1">
                                @(Model.ReservationDate.ToLocalTime().ToString("hh:mm tt"))
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">
                                STATUS
                            </label>

                            <div class="mt-2">

                                @* Displays a different badge depending on the reservation status. *@
                                @if (Model.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">
                                        <i class="bi bi-clock me-1"></i>
                                        Pending
                                    </span>
                                }
                                else if (Model.Status == "Approved")
                                {
                                    <span class="badge bg-success px-3 py-2">
                                        <i class="bi bi-check-circle me-1"></i>
                                        Approved
                                    </span>
                                }
                                else if (Model.Status == "Completed")
                                {
                                    <span class="badge bg-primary px-3 py-2">
                                        <i class="bi bi-check-all me-1"></i>
                                        Completed
                                    </span>
                                }
                                else if (Model.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger px-3 py-2">
                                        <i class="bi bi-x-circle me-1"></i>
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">
                                        @Model.Status
                                    </span>
                                }

                            </div>
                        </div>

                        <!-- QR Status -->
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold">
                                QR TOKEN
                            </label>

                            <div class="mt-2">

                                @* Indicates whether a QR token has been generated for the reservation. *@
                                @if (!string.IsNullOrWhiteSpace(Model.QrToken))
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2">
                                        <i class="bi bi-qr-code me-1"></i>
                                        QR Token Available
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not available
                                    </span>
                                }

                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- QR / Status Card -->
        <div class="col-lg-4">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-semibold">
                        <i class="bi bi-qr-code me-2"></i>
                        Reservation QR
                    </h5>
                </div>

                <div class="card-body text-center">

                    @* Displays the QR token when the reservation has been approved. *@
                    @if (!string.IsNullOrWhiteSpace(Model.QrToken))
                    {
                        <div class="mb-3">

                            <div class="border rounded p-4 bg-light">
                                <i class="bi bi-qr-code display-1 text-dark"></i>
                            </div>

                        </div>

                        <p class="text-muted small mb-2">
                            QR token generated after approval.
                        </p>

                        <div class="alert alert-light border text-start">
                            <small class="font-monospace text-break">
                                @Model.QrToken
                            </small>
                        </div>
                    }
                    else
                    {
                        <div class="py-4">

                            <i class="bi bi-qr-code display-4 text-muted"></i>

                            <h6 class="mt-3">
                                QR Not Available
                            </h6>

                            <p class="text-muted small mb-0">
                                A QR token will be available after
                                the reservation is approved.
                            </p>

                        </div>
                    }

                </div>

            </div>

            <!-- Actions -->
            @* Shows reservation actions only while the reservation is pending or approved. *@
            @if (Model.Status == "Pending" ||
                 Model.Status == "Approved")
            {
                <div class="card shadow-sm border-0 mt-4">

                    <div class="card-body">

                        <h6 class="fw-semibold mb-3">
                            Reservation Actions
                        </h6>

                        <!-- Edit -->
                        <a asp-controller="Reservations"
                           asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary w-100 mb-2">

                            <i class="bi bi-pencil-square me-1"></i>
                            Edit Reservation

                        </a>

                        <!-- Approve -->
                        @if (Model.Status == "Pending")
                        {
                            <form asp-controller="Reservations"
                                  asp-action="Approve"
                                  asp-route-id="@Model.Id"
                                  method="post"
                                  class="mb-2">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-success w-100"
                                        onclick="return confirm('Are you sure you want to approve this reservation?');">

                                    <i class="bi bi-check-lg me-1"></i>
                                    Approve Reservation

                                </button>

                            </form>
                        }

                        <!-- Cancel -->
                        <form asp-controller="Reservations"
                              asp-action="Cancel"
                              asp-route-id="@Model.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger w-100"
                                    onclick="return confirm('Are you sure you want to cancel this reservation?');">

                                <i class="bi bi-x-lg me-1"></i>
                                Cancel Reservation

                            </button>

                        </form>

                    </div>

                </div>
            }

        </div>

    </div>

</div>