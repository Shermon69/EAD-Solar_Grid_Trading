<?xml version="1.0" encoding="utf-8"?>

<!--
    File:        activity_edit_reservation.xml
    Author:      Dissanayake D.M.S.N (IT22210692)
    Description: UI layout for editing an existing energy reservation.
-->

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page title -->
        <TextView
            android:id="@+id/tvEditReservationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Reservation"
            android:textColor="#123B6D"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- Page description -->
        <TextView
            android:id="@+id/tvEditReservationSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update your energy reservation"
            android:textColor="#667085"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <!-- Station selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Station"
            android:textColor="#667085"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerEditStation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <!-- Reservation date -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reservation Date"
            android:textColor="#667085"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEditDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Date"
            android:textAllCaps="false"
            android:layout_marginBottom="20dp" />

        <!-- Time slot selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time Slot"
            android:textColor="#667085"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerEditSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <!-- Energy amount -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Energy (kWh)"
            android:textColor="#667085"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEditEnergyKwh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter energy amount"
            android:inputType="numberDecimal"
            android:layout_marginBottom="20dp" />

        <!-- Reservation type -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reservation Type"
            android:textColor="#667085"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerEditReservationType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp" />

        <!-- Save changes -->
        <Button
            android:id="@+id/btnSaveReservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp" />

        <!-- Loading indicator shown while the reservation is being processed -->
        <ProgressBar
            android:id="@+id/progressEditReservation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>