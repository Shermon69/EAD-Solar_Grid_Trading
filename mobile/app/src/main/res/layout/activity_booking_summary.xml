<?xml version="1.0" encoding="utf-8"?>

<!--
    File:        activity_booking_summary.xml
    Author:      Shermon H (IT22177964)
    Description: Summary page shown after a booking is created, updated
                 or cancelled. Shows the booking as returned by the Web API.
-->

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title changes with the action: created / updated / cancelled -->
        <TextView
            android:id="@+id/tvSummaryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Booking Created"
            android:textColor="#123B6D"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvSummaryMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Here is a summary of your booking."
            android:textColor="#667085"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <!-- Booking details card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Booking Reference"
                android:textColor="#667085"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryReference"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#123B6D"
                android:textSize="15sp"
                android:textIsSelectable="true"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Station"
                android:textColor="#667085"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryStation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#123B6D"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reservation Date"
                android:textColor="#667085"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#123B6D"
                android:textSize="18sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reservation Type"
                android:textColor="#667085"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#123B6D"
                android:textSize="18sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Energy"
                android:textColor="#667085"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryEnergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#123B6D"
                android:textSize="18sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textColor="#667085"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSummaryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#123B6D"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- What happens next (depends on the action) -->
        <TextView
            android:id="@+id/tvSummaryNextStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#667085"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnSummaryViewBooking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Booking"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSummaryDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Done"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>
