<?xml version="1.0" encoding="utf-8"?>
<!--
    File:        item_detail_row.xml
    Author:      WMVSB Wahundeniya (IT22292872)
    Description: One "label ........ value" row, inflated in code to list the details
                 of a scanned reservation or a station's opening hours.
    Created:     15/10/2026
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="7dp">

    <TextView
        android:id="@+id/tvRowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvRowValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1.4"
        android:gravity="end"
        android:textColor="@color/text_primary"
        android:textIsSelectable="true"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
