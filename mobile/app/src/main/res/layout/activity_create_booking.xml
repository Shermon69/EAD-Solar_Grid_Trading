<?xml version="1.0" encoding="utf-8"?>

<!--
    File:        activity_create_booking.xml
    Author:      Dissanayake D.M.S.N (IT22210692)
    Description: UI layout for creating an energy reservation.
-->

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page title -->
        <TextView
            android:id="@+id/tvCreateBookingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Booking"
            android:textColor="#123B6D"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvCreateBookingSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reserve an energy trading slot"
            android:textColor="#667085"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <!-- Station -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Station"
            android:textColor="#344054"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerStation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="20dp" />

        <!-- Date -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reservation Date"
            android:textColor="#344054"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectDate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Select Date"
            android:textAllCaps="false"
            android:layout_marginBottom="20dp" />

        <!-- Available slots -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available Time Slot"
            android:textColor="#344054"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerSlot"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="20dp" />

        <!-- Energy amount -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Energy (kWh)"
            android:textColor="#344054"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEnergyKwh"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Enter energy amount"
            android:inputType="numberDecimal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- Reservation type -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reservation Type"
            android:textColor="#344054"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerReservationType"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#FFFFFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="28dp" />

        <!-- Submit -->
        <Button
            android:id="@+id/btnCreateBooking"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Create Reservation"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp" />

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressCreateBooking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</ScrollView>