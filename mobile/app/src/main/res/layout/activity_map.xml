<?xml version="1.0" encoding="utf-8"?>
<!--
    File:        activity_map.xml
    Author:      WMVSB Wahundeniya (IT22292872)
    Description: Full screen map (Google Maps or free OpenStreetMap) of nearby solar stations. A floating top bar
                 holds the title, refresh button and search radius chips; a bottom
                 card shows the selected station with Directions and View details.
    Created:     29/09/2026
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Google Maps or OpenStreetMap is added here in code (see maps/StationMaps.java) -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top overlay: title bar, radius filter and offline banner -->
    <LinearLayout
        android:id="@+id/layoutTopOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/btn_back"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/navy" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/map_title"
                            android:textColor="@color/navy"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMapSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/map_loading"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnMapType"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/map_type"
                        android:src="@drawable/ic_layers"
                        app:tint="@color/navy" />

                    <ImageButton
                        android:id="@+id/btnRefresh"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/btn_refresh"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/navy" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressMap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/solar"
                    app:trackThickness="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Search radius (chips are added in code) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRadius"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvOfflineBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/danger_light"
            android:drawableStart="@drawable/ic_cloud_off"
            android:drawablePadding="8dp"
            android:drawableTint="@color/danger"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/map_offline"
            android:textColor="@color/danger"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom overlay: my location button and selected station card -->
    <LinearLayout
        android:id="@+id/layoutBottomOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/map_my_location"
            android:src="@drawable/ic_my_location"
            app:backgroundTint="@color/white"
            app:fabSize="normal"
            app:tint="@color/navy" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_circle"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_sun"
                        app:tint="@color/solar" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCardName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCardAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Info pills -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCardDistance"
                        style="@style/Widget.SolarGrid.InfoPill"
                        android:backgroundTint="@color/navy_light"
                        android:drawableStart="@drawable/ic_place_small"
                        android:drawableTint="@color/navy"
                        android:textColor="@color/navy" />

                    <TextView
                        android:id="@+id/tvCardCapacity"
                        style="@style/Widget.SolarGrid.InfoPill"
                        android:backgroundTint="@color/solar_light"
                        android:drawableStart="@drawable/ic_bolt_small"
                        android:drawableTint="@color/solar"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvCardSlots"
                        style="@style/Widget.SolarGrid.InfoPill"
                        android:backgroundTint="@color/success_light"
                        android:drawableStart="@drawable/ic_battery_small"
                        android:drawableTint="@color/success"
                        android:textColor="@color/success" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCardDirections"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:text="@string/btn_directions"
                        android:textColor="@color/navy"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_directions"
                        app:iconTint="@color/navy"
                        app:strokeColor="@color/navy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCardDetails"
                        style="@style/Widget.SolarGrid.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:text="@string/btn_view_details" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</FrameLayout>
