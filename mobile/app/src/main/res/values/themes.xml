<?xml version="1.0" encoding="utf-8"?>
<!-- App theme (Material 3). Every screen uses this so the app looks consistent. -->
<resources>
    <style name="Theme.SolarGrid" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/solar</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Main action button (solar orange) -->
    <style name="Widget.SolarGrid.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/solar</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Card used for menu items on the home screens -->
    <style name="Widget.SolarGrid.MenuCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <!-- Small rounded info tag with an icon, e.g. "2.4 km" or "120 kW/h" (Member 3 screens).
         Set backgroundTint, drawableStart, drawableTint and textColor on each use. -->
    <style name="Widget.SolarGrid.InfoPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
